# Anthropic API key (server-side only, never exposed to the browser)
ANTHROPIC_API_KEY=

# Model used by the agent (optional)
ANTHROPIC_MODEL=claude-sonnet-5-5

# Postgres connection for the READ-ONLY role `askdb_reader`.
# This is the only connection string the app ever uses at runtime.
DATABASE_URL=

# Admin connection used ONLY by `npm run db:setup` to create tables, seed
# data and create the reader role. Never set this on Vercel.
DATABASE_URL_ADMIN=
